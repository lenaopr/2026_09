    "        .rename_axis(\"unknown_event_action\")\n",
    "        .reset_index(name=\"event_count\")\n",
    "    )\n",
    "\n",
    "    return unknown_events\n",
    "\n",
    "\n",
    "unknown_events = list_unknown_events(df_bq)\n",
    "unknown_events"
